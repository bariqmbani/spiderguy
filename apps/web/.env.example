# Public configuration only. Never put provider keys, service-role keys, or Google secrets here.
VITE_SUPABASE_URL=http://127.0.0.1:54321
VITE_SUPABASE_PUBLISHABLE_KEY=
# "Continue with Google" uses the Supabase Auth Google provider (configure it in Supabase; no client ID needed here).
VITE_ENABLE_GOOGLE_AUTH=true
# Development convenience: email/password sign-in when Google sign-in is not configured.
VITE_ENABLE_PASSWORD_AUTH=true
