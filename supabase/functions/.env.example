# Copy to supabase/functions/.env for `supabase functions serve`, or set as hosted Edge Function secrets
# (or Vault secrets with the same names; see README). Never commit real values.
TYPESAFE_API_KEY=
JEV_MODEL=jev-latest
LLM_BASE_URL=https://<resource>.openai.azure.com/openai/v1
LLM_API_KEY=
LLM_MODEL=gpt-4.1-mini
EMBEDDING_BASE_URL=https://<resource>.services.ai.azure.com/openai/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
# Shared secret the scheduler (pg_cron/pg_net or an operator cron) sends as a Bearer token to /api/ingest-worker.
WORKER_TOKEN=
# base64-encoded 32 random bytes: openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_API_KEY=
GOOGLE_APP_ID=
